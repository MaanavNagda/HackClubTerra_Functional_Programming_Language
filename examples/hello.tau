;;Tau demo - bindings, arithmetic, conditionsals

let x = 14 ;; first binding, assigning 14 to the variable name x
let y = x * 13 ;; artihmetic operation (multiplication), and binding the result to the variable name y
let z = y + x * x ;;arithemtic operation (multiple) that tests BODMAS and precedence, and binding the result to the variable name z
let verdict = if  z > 169 then 1 else 0 ;; adding conditional stateents 
x + y + z ;;final output which results in a number being outputted, so just some basic arithmetic